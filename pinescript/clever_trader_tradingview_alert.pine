//@version=5
indicator("THE CLEVER TRADER — 4-Agent Neural Swarm & SMC 1:3 Engine v5", overlay=true, precision=2)

// ==============================================================================
// THE CLEVER TRADER — INSTITUTIONAL QUANT HEDGE FUND TERMINAL
// 4-Agent Neural Swarm Confluence & Strict 1:3 Risk-Reward Execution Engine
// ==============================================================================
// Webhook Setup:
// 1. Condition: "THE CLEVER TRADER — 4-Agent Neural Swarm & SMC 1:3 Engine v5" -> "Any alert() function call"
// 2. Webhook URL: https://YOUR_SUBDOMAIN.loca.lt/api/webhook/tradingview
// 3. Message: {{alert.message}}
// ==============================================================================

// ------------------------------------------------------------------------------
// INPUT PARAMETERS & USER CONTROLS
// ------------------------------------------------------------------------------
grp_security   = "🔐 Authentication & Webhook Security"
secretKey      = input.string("clever_trader_secure_pass_2026", "Clever Trader Secret Key", group=grp_security)

grp_pro_rules  = "🎯 Pro Rules & Asymmetric 1:3 Execution"
riskReward     = input.float(3.0, "Risk-to-Reward Ratio (Strict 1:3)", minval=2.0, maxval=5.0, step=0.1, group=grp_pro_rules)
minConfluence  = input.int(80, "Minimum Confluence Score (80+ A+ Tier)", minval=70, maxval=100, step=5, group=grp_pro_rules)
sessionFilter  = input.bool(true, "Enforce London & NY Killzones (No Asian Chop)", group=grp_pro_rules)
trendFilter    = input.bool(true, "Enforce Higher-Timeframe Trend Alignment (200 EMA)", group=grp_pro_rules)
volFilter      = input.bool(true, "Enforce Institutional Volume Displacement", group=grp_pro_rules)

grp_visuals    = "🎨 Visual HUD & Styling"
showHUD        = input.bool(true, "Show On-Chart Institutional HUD Table", group=grp_visuals)
showLevels     = input.bool(true, "Plot Real-Time SL & TP Target Lines", group=grp_visuals)
showSessions   = input.bool(true, "Highlight London & New York Session Backgrounds", group=grp_visuals)
showScores     = input.bool(true, "Show Score Badges on Trigger", group=grp_visuals)

// ------------------------------------------------------------------------------
// AGENT 1: TRADING STRATEGIST (SMC / ICT Market Structure & Fair Value Gaps)
// ------------------------------------------------------------------------------
// Fair Value Gaps (FVG) Detection
bullFVG = low > high[2] and close > high[2]
bearFVG = high < low[2] and close < low[2]

// Market Structure Shift (MSS) / Break of Structure (BOS)
swingHigh = ta.highest(high[1], 10)
swingLow  = ta.lowest(low[1], 10)
bullMSS   = ta.crossover(close, swingHigh)
bearMSS   = ta.crossunder(close, swingLow)

// ------------------------------------------------------------------------------
// AGENT 2: RISK ANALYST (Strict 1:3 Asymmetric Payoff & Dynamic ATR Buffer)
// ------------------------------------------------------------------------------
atrPeriod = 14
atr = ta.atr(atrPeriod)

// Adaptive Structure Stop-Loss
longSL  = math.min(low, low[1]) - (atr * 0.8)
shortSL = math.max(high, high[1]) + (atr * 0.8)

// Exact 1:3 Risk-to-Reward Target
longRisk  = close - longSL
longTP    = close + (longRisk * riskReward)

shortRisk = shortSL - close
shortTP   = close - (shortRisk * riskReward)

// ------------------------------------------------------------------------------
// AGENT 3: MARKET ANALYST (Session Killzones & Macro Trend Alignment)
// ------------------------------------------------------------------------------
// UTC Time Sessions: London (07:00-10:00 UTC) & New York (12:00-15:00 UTC)
inLondon   = not na(time(timeframe.period, "0700-1000:1234567", "UTC"))
inNewYork  = not na(time(timeframe.period, "1200-1500:1234567", "UTC"))
isInSession = not sessionFilter or (inLondon or inNewYork)

// Macro Trend Filters (50 EMA & 200 EMA)
ema50  = ta.ema(close, 50)
ema200 = ta.ema(close, 200)
macroBull = not trendFilter or (close > ema200 and ema50 > ema200)
macroBear = not trendFilter or (close < ema200 and ema50 < ema200)

// ------------------------------------------------------------------------------
// AGENT 4: QUANT & BACKTEST AUDITOR (Institutional Volume Displacement)
// ------------------------------------------------------------------------------
volMA = ta.sma(volume, 20)
hasVolDisplacement = not volFilter or (volume > volMA * 1.20)

// ------------------------------------------------------------------------------
// 4-AGENT SWARM CONFLUENCE SCORING PROTOCOL
// ------------------------------------------------------------------------------
calcConfluenceScore(bool isBuy) =>
    int fvgPts = (isBuy ? bullFVG : bearFVG) ? 25 : 0
    int mssPts = (isBuy ? (bullMSS or close > ema50) : (bearMSS or close < ema50)) ? 15 : 0
    int macPts = (isBuy ? macroBull : macroBear) ? 25 : 0
    int volPts = hasVolDisplacement ? 20 : 0
    int sesPts = isInSession ? 15 : 0
    fvgPts + mssPts + macPts + volPts + sesPts

buyScore  = calcConfluenceScore(true)
sellScore = calcConfluenceScore(false)

// Master Execution Signals (Requires 80+ Score & Session Active)
buySignal  = bullFVG and macroBull and hasVolDisplacement and isInSession and buyScore >= minConfluence
sellSignal = bearFVG and macroBear and hasVolDisplacement and isInSession and sellScore >= minConfluence

// Prevent multi-triggering on same candle
var int lastSignalBar = 0
validBuy  = buySignal and bar_index != lastSignalBar
validSell = sellSignal and bar_index != lastSignalBar

if validBuy or validSell
    lastSignalBar := bar_index

// ------------------------------------------------------------------------------
// CHART VISUALIZATIONS & SIGNAL SHAPES
// ------------------------------------------------------------------------------
// Plot EMAs
plot(ema50, "50 EMA (Fast Structure)", color=color.new(#00f0ff, 40), linewidth=1)
plot(ema200, "200 EMA (Macro Baseline)", color=color.new(#f59e0b, 20), linewidth=2)

// Highlight Killzone Backgrounds
bgcolor(showSessions and inLondon ? color.new(#0284c7, 92) : na, title="London Killzone Tint")
bgcolor(showSessions and inNewYork ? color.new(#10b981, 92) : na, title="New York Killzone Tint")

// Plot Buy & Sell Shapes with Constant String Text (Pine Script v5 Requirement)
plotshape(validBuy, title="BUY Signal (1:3 R:R)", location=location.belowbar, 
          color=color.new(#00f0ff, 0), style=shape.labelup, 
          text="BUY 1:3", textcolor=color.new(#050811, 0), size=size.normal)

plotshape(validSell, title="SELL Signal (1:3 R:R)", location=location.abovebar, 
          color=color.new(#ec4899, 0), style=shape.labeldown, 
          text="SELL 1:3", textcolor=color.white, size=size.normal)

// Dynamic Confluence Score Badges
if validBuy and showScores
    label.new(bar_index, low - (atr * 0.7), "Score " + str.tostring(buyScore) + "/100", 
              color=color.new(#00f0ff, 20), textcolor=color.white, 
              style=label.style_label_up, size=size.small)

if validSell and showScores
    label.new(bar_index, high + (atr * 0.7), "Score " + str.tostring(sellScore) + "/100", 
              color=color.new(#ec4899, 20), textcolor=color.white, 
              style=label.style_label_down, size=size.small)

// Dynamic TP / SL Targets on Valid Trigger
var float activeSL = na
var float activeTP = na

if validBuy
    activeSL := longSL
    activeTP := longTP
if validSell
    activeSL := shortSL
    activeTP := shortTP

plot(showLevels ? activeSL : na, "Active Stop-Loss Target", color=color.new(#ef4444, 0), style=plot.style_linebr, linewidth=2)
plot(showLevels ? activeTP : na, "Active Take-Profit Target (1:3)", color=color.new(#10b981, 0), style=plot.style_linebr, linewidth=2)

// ------------------------------------------------------------------------------
// ON-CHART INSTITUTIONAL HUD TABLE
// ------------------------------------------------------------------------------
var table hud = table.new(position.top_right, 2, 6, bgcolor=color.new(#0b0e17, 10), border_color=color.new(#00f0ff, 60), border_width=1)

if barstate.islast and showHUD
    // Header
    table.cell(hud, 0, 0, "CLEVER TRADER", bgcolor=color.new(#00f0ff, 20), text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 0, "SWARM v5", bgcolor=color.new(#00f0ff, 20), text_color=color.new(#00f0ff, 0), text_size=size.small)
    
    // Session status
    sessionName = inLondon ? "LONDON KILLZONE" : inNewYork ? "NEW YORK KILLZONE" : "OFF-HOURS / CHOP"
    sessionCol  = inLondon or inNewYork ? color.new(#10b981, 0) : color.new(#f59e0b, 0)
    table.cell(hud, 0, 1, "Active Session", text_color=color.gray, text_size=size.tiny)
    table.cell(hud, 1, 1, sessionName, text_color=sessionCol, text_size=size.tiny)

    // Macro Trend
    trendText = close > ema200 ? "BULLISH (Above 200)" : "BEARISH (Below 200)"
    trendCol  = close > ema200 ? color.new(#00f0ff, 0) : color.new(#ec4899, 0)
    table.cell(hud, 0, 2, "Macro Trend", text_color=color.gray, text_size=size.tiny)
    table.cell(hud, 1, 2, trendText, text_color=trendCol, text_size=size.tiny)

    // Target R:R
    table.cell(hud, 0, 3, "Target R:R", text_color=color.gray, text_size=size.tiny)
    table.cell(hud, 1, 3, "1 : 3.0 STRICT", text_color=color.new(#10b981, 0), text_size=size.tiny)

    // Min Score
    table.cell(hud, 0, 4, "Quality Bar", text_color=color.gray, text_size=size.tiny)
    table.cell(hud, 1, 4, str.tostring(minConfluence) + " / 100 A+", text_color=color.white, text_size=size.tiny)

    // Webhook Status
    table.cell(hud, 0, 5, "Exness MT5 Bridge", text_color=color.gray, text_size=size.tiny)
    table.cell(hud, 1, 5, "ACTIVE & ARMED", text_color=color.new(#00f0ff, 0), text_size=size.tiny)

// ------------------------------------------------------------------------------
// ZERO-LAG WEBHOOK ALERT DISPATCH TO CLEVER TRADER & EXNESS MT5
// ------------------------------------------------------------------------------
if validBuy
    buyAlertJson = '{"secret":"' + secretKey + '","symbol":"' + syminfo.ticker + '","action":"BUY","price":' + str.tostring(close, "#.##") + ',"sl":' + str.tostring(longSL, "#.##") + ',"tp":' + str.tostring(longTP, "#.##") + ',"rr":3.0,"score":' + str.tostring(buyScore) + ',"strategy":"Clever Trader 4-Agent Swarm 1:3"}'
    alert(buyAlertJson, alert.freq_once_per_bar_close)

if validSell
    sellAlertJson = '{"secret":"' + secretKey + '","symbol":"' + syminfo.ticker + '","action":"SELL","price":' + str.tostring(close, "#.##") + ',"sl":' + str.tostring(shortSL, "#.##") + ',"tp":' + str.tostring(shortTP, "#.##") + ',"rr":3.0,"score":' + str.tostring(sellScore) + ',"strategy":"Clever Trader 4-Agent Swarm 1:3"}'
    alert(sellAlertJson, alert.freq_once_per_bar_close)
