// © CustomProfessional & The Clever Trader Quant Lab
// @version=6

// ==============================================================================
// SCRIPT: Institutional Edge Toolkit [ULTRA PRO] — Multi-Confluence Quant Engine
// DESCRIPTION: Professional-grade institutional Smart Money Concepts (SMC) + 
//              Advanced Delta Volume + Speedometer Score + Auto SL/TP Engine.
// UPGRADE: 100% Mathematically Connected Signals (No Lagging Disconnect) +
//          Automated JSON Webhook Alert for Direct Exness MT5 Execution.
// ==============================================================================

indicator('Institutional Edge Toolkit [ULTRA PRO]', shorttitle='IET Ultra Pro', overlay=true, max_lines_count=500, max_boxes_count=500, max_labels_count=500, max_bars_back=5000)

// ==========================================
// 1. INPUTS & CONFIGURATION
// ==========================================

// --- Quantitative Confluence Filters ---
group_quant       = '★ QUANT CONFLUENCE FILTERS'
min_speedometer   = input.int(60, 'Min Speedometer Score (Buy >= X, Sell <= 100-X)', minval=50, maxval=85, group=group_quant, tooltip='Requires multi-engine momentum confirmation before triggering trades.')
require_delta     = input.bool(true, 'Require Delta Volume Flow Confirmation', group=group_quant, tooltip='Requires buying volume > selling volume for Longs.')
require_htf_ema   = input.bool(true, 'Filter by Higher Timeframe Daily Trend', group=group_quant)
min_rr_ratio      = input.float(2.5, 'Target Risk-to-Reward (R:R Ratio)', minval=1.5, maxval=5.0, step=0.5, group=group_quant)

// --- Clever Trader Webhook Bridge ---
group_bridge      = '★ CLEVER TRADER WEBHOOK INTEGRATION'
enable_ct_alert   = input.bool(true, 'Enable Clever Trader MT5 JSON Webhook Alerts', group=group_bridge)
secret_key        = input.string('clever_trader_secure_pass_2026', 'Clever Trader Secret Key', group=group_bridge)

// --- Market Structure ---
group_structure   = 'Market Structure'
lookback_period   = input.int(5, 'Swing Lookback', minval=1, group=group_structure, tooltip='Bars to confirm a pivot point.')
show_bos_mss      = input.bool(true, 'Show BOS/MSS Labels', group=group_structure)
show_swing_pts    = input.bool(false, 'Show HH/LL/LH/LL Labels', group=group_structure)

// --- PD Arrays (OB & FVG) ---
group_arrays      = 'PD Arrays (FVG/OB)'
show_fvg          = input.bool(true, 'Show Fair Value Gaps', group=group_arrays)
fvg_atr_mult      = input.float(0.5, 'FVG Min Size (ATR)', minval=0.1, step=0.1, group=group_arrays)
show_ob           = input.bool(true, 'Show Order Blocks', group=group_arrays)
ob_atr_mult       = input.float(2.0, 'OB Min Displacement (ATR)', minval=0.1, step=0.1, group=group_arrays)
ob_vol_mult       = input.float(1.0, 'OB Min Volume (Avg Mult)', minval=0.1, step=0.1, group=group_arrays)
ob_extend         = input.int(15, 'OB Extension (Bars)', minval=1, group=group_arrays)

// --- MTF & Bias ---
group_mtf         = 'MTF Analysis & Dashboard'
mtf_tf            = input.timeframe("D", "Primary Higher Timeframe", group=group_mtf)
mtf_ema_len       = input.int(50, "MTF EMA Period", group=group_mtf)
show_mtf_bg       = input.bool(false, 'Color Chart Background by MTF Bias', group=group_mtf)
show_dashboard    = input.bool(true, 'Show Multi-TF Dashboard', group=group_mtf)
dash_pos          = input.string('Top Right', 'Dashboard Position', options=['Top Right', 'Bottom Right', 'Top Left', 'Bottom Left'], group=group_mtf)

// --- Liquidity & Sessions ---
group_liq         = 'Liquidity Sweeps'
show_sweeps       = input.bool(true, 'Detect Liquidity Sweeps', group=group_liq)
min_wick_perc     = input.float(40.0, 'Min Wick Rejection %', minval=0.0, maxval=100.0, group=group_liq)
sweep_cooldown    = input.int(10, 'Sweep Detection Cooldown', minval=1, group=group_liq)

group_amd         = 'AMD Session Strategy'
show_amd          = input.bool(true, 'Highlight AMD Sessions', group=group_amd)
amd_session       = input.session('1800-0000', 'Accumulation Session (NY)', group=group_amd)

// --- Aesthetics ---
group_style       = 'Style & Aesthetics'
color_bull        = input.color(color.new(#00ffbb, 0), 'Bullish Primary Color', group=group_style)
color_bear        = input.color(color.new(#ff0055, 0), 'Bearish Primary Color', group=group_style)
color_ob_bull     = input.color(color.new(#00ffbb, 85), 'Bullish OB Fill', group=group_style)
color_ob_bear     = input.color(color.new(#ff0055, 85), 'Bearish OB Fill', group=group_style)

// --- Advanced Delta Volume Dashboard ---
group_vol_dash    = 'Delta Volume Dashboard'
show_vol_dash     = input.bool(true, 'Show Volume Dashboard', group=group_vol_dash)
vol_bull_col      = input.color(#00ffd5, 'Delta Bull Color', group=group_vol_dash)
vol_bear_col      = input.color(#ff0070, 'Delta Bear Color', group=group_vol_dash)

// ==========================================
// 2. CORE LOGIC & DATA FETCHING
// ==========================================

// Security Calls (Zero Repainting with lookahead_off)
[htf_close, htf_ema_val] = request.security(syminfo.tickerid, mtf_tf, [close[1], ta.ema(close, mtf_ema_len)[1]], lookahead=barmerge.lookahead_off)

// MTF Dashboard values
m15_bias = request.security(syminfo.tickerid, "15", close[1] > ta.ema(close, 50)[1] ? 1 : -1, lookahead=barmerge.lookahead_off)
h1_bias  = request.security(syminfo.tickerid, "60", close[1] > ta.ema(close, 50)[1] ? 1 : -1, lookahead=barmerge.lookahead_off)
h4_bias  = request.security(syminfo.tickerid, "240", close[1] > ta.ema(close, 50)[1] ? 1 : -1, lookahead=barmerge.lookahead_off)

// System Variables
atr_sys = ta.atr(14)
pivot_h = ta.pivothigh(high, lookback_period, lookback_period)
pivot_l = ta.pivotlow(low, lookback_period, lookback_period)

var float last_sh_val = na
var float last_sl_val = na
if not na(pivot_h)
    last_sh_val := pivot_h
if not na(pivot_l)
    last_sl_val := pivot_l

// ==========================================
// 3. MARKET STRUCTURE ENGINE
// ==========================================

var float smc_hh = na, var int hh_bar = 0
var float smc_ll = na, var int ll_bar = 0
var float smc_lh = na, var int lh_bar = 0
var float smc_hl = na, var int hl_bar = 0
var bool hh_broken = false, var bool ll_broken = false
var int trend_state = 0

if not na(pivot_h)
    if na(smc_hh) or pivot_h > smc_hh
        smc_hh := pivot_h, hh_bar := bar_index[lookback_period], hh_broken := false
        if show_swing_pts
            label.new(hh_bar, smc_hh, "HH", color=color.new(color_bull, 100), textcolor=color_bull, style=label.style_none, size=size.tiny)
    else
        smc_lh := pivot_h, lh_bar := bar_index[lookback_period]
        if show_swing_pts
            label.new(lh_bar, smc_lh, "LH", color=color.new(color_bull, 100), textcolor=color_bull, style=label.style_none, size=size.tiny)

if not na(pivot_l)
    if na(smc_ll) or pivot_l < smc_ll
        smc_ll := pivot_l, ll_bar := bar_index[lookback_period], ll_broken := false
        if show_swing_pts
            label.new(ll_bar, smc_ll, "LL", color=color.new(color_bear, 100), textcolor=color_bear, style=label.style_none, size=size.tiny, yloc=yloc.belowbar)
    else
        smc_hl := pivot_l, hl_bar := bar_index[lookback_period]
        if show_swing_pts
            label.new(hl_bar, smc_hl, "HL", color=color.new(color_bear, 100), textcolor=color_bear, style=label.style_none, size=size.tiny, yloc=yloc.belowbar)

// BOS & MSS Implementation
if show_bos_mss
    if not hh_broken and not na(smc_hh) and close > smc_hh and barstate.isconfirmed
        if bar_index - hh_bar < 4500
            line.new(hh_bar, smc_hh, bar_index, smc_hh, color=color_bull, style=line.style_dashed)
            label.new(math.round(math.avg(hh_bar, bar_index)), smc_hh, "BOS", color=color.new(color.black, 100), textcolor=color_bull, style=label.style_none, size=size.small)
        hh_broken := true, trend_state := 1
    
    if not ll_broken and not na(smc_ll) and close < smc_ll and barstate.isconfirmed
        if bar_index - ll_bar < 4500
            line.new(ll_bar, smc_ll, bar_index, smc_ll, color=color_bear, style=line.style_dashed)
            label.new(math.round(math.avg(ll_bar, bar_index)), smc_ll, "BOS", color=color.new(color.black, 100), textcolor=color_bear, style=label.style_none, size=size.small)
        ll_broken := true, trend_state := -1

    if trend_state == 1 and not na(smc_hl) and close < smc_hl and barstate.isconfirmed
        if bar_index - hl_bar < 4500
            line.new(hl_bar, smc_hl, bar_index, smc_hl, color=color.orange, width=2)
            label.new(math.round(math.avg(hl_bar, bar_index)), smc_hl, "MSS ↓", color=color.new(color.black, 100), textcolor=color.orange, style=label.style_none, size=size.small)
        trend_state := -1
    
    if trend_state == -1 and not na(smc_lh) and close > smc_lh and barstate.isconfirmed
        if bar_index - lh_bar < 4500
            line.new(lh_bar, smc_lh, bar_index, smc_lh, color=color.yellow, width=2)
            label.new(math.round(math.avg(lh_bar, bar_index)), smc_lh, "MSS ↑", color=color.new(color.black, 100), textcolor=color.yellow, style=label.style_none, size=size.small)
        trend_state := 1

// ==========================================
// 4. PD ARRAYS (FVG & ORDER BLOCKS)
// ==========================================

var bull_obs = array.new_box()
var bear_obs = array.new_box()
var fvg_boxes = array.new_box()
max_mem = 40

bool is_fvg_bull = low > high[2] and close[1] > open[1] and (low - high[2]) > atr_sys * fvg_atr_mult
bool is_fvg_bear = high < low[2] and close[1] < open[1] and (low[2] - high) > atr_sys * fvg_atr_mult

if show_fvg
    if is_fvg_bull or is_fvg_bear
        if array.size(fvg_boxes) > max_mem
            box.delete(array.shift(fvg_boxes))
        
        c = is_fvg_bull ? color.new(color_bull, 85) : color.new(color_bear, 85)
        txt = "FVG"
        b_idx_start = bar_index[2]
        top = is_fvg_bull ? low : low[2]
        bot = is_fvg_bull ? high[2] : high
        
        array.push(fvg_boxes, box.new(b_idx_start, top, bar_index + 5, bot, bgcolor=c, border_color=color.new(c, 50), text=txt, text_size=size.tiny, text_color=color.new(color.white, 30)))

is_disp = math.abs(close[1] - open[1]) > atr_sys * ob_atr_mult and (volume[1] > ta.sma(volume, 20) * ob_vol_mult)

if show_ob and is_disp
    if low > high[2]
        int ob_idx = na
        for i = 2 to 5
            if close[i] < open[i]
                ob_idx := i
                break
        if not na(ob_idx) and close[1] > high[ob_idx]
            if array.size(bull_obs) > max_mem
                box.delete(array.shift(bull_obs))
            array.push(bull_obs, box.new(bar_index[ob_idx], high[ob_idx], bar_index + ob_extend, low[ob_idx], bgcolor=color_ob_bull, border_color=color.new(color_bull, 70), text="OB+", text_color=color.new(color_bull, 30)))

    if high < low[2]
        int ob_idx = na
        for i = 2 to 5
            if close[i] > open[i]
                ob_idx := i
                break
        if not na(ob_idx) and close[1] < low[ob_idx]
            if array.size(bear_obs) > max_mem
                box.delete(array.shift(bear_obs))
            array.push(bear_obs, box.new(bar_index[ob_idx], high[ob_idx], bar_index + ob_extend, low[ob_idx], bgcolor=color_ob_bear, border_color=color.new(color_bear, 70), text="OB-", text_color=color.new(color_bear, 30)))

if array.size(bull_obs) > 0
    for i = array.size(bull_obs) - 1 to 0
        b = array.get(bull_obs, i)
        if low <= box.get_top(b)
            box.delete(array.remove(bull_obs, i))

if array.size(bear_obs) > 0
    for i = array.size(bear_obs) - 1 to 0
        b = array.get(bear_obs, i)
        if high >= box.get_bottom(b)
            box.delete(array.remove(bear_obs, i))

// ==========================================
// 5. LIQUIDITY & SESSIONS
// ==========================================

bool is_bull_sweep = false
bool is_bear_sweep = false

if show_sweeps
    var int last_sweep_bar = 0
    can_trigger = (bar_index - last_sweep_bar) >= sweep_cooldown
    c_size = high - low
    l_wick = c_size > 0 ? (math.min(open, close) - low) / c_size * 100 : 0
    u_wick = c_size > 0 ? (high - math.max(open, close)) / c_size * 100 : 0
    
    if can_trigger and not na(last_sl_val) and low < last_sl_val and close > last_sl_val and l_wick >= min_wick_perc
        label.new(bar_index, low, 'SWEEP', style=label.style_label_up, color=color.new(color.blue, 20), textcolor=color.white, size=size.small, yloc=yloc.belowbar)
        last_sweep_bar := bar_index
        is_bull_sweep := true

    if can_trigger and not na(last_sh_val) and high > last_sh_val and close < last_sh_val and u_wick >= min_wick_perc
        label.new(bar_index, high, 'SWEEP', style=label.style_label_down, color=color.new(color.red, 20), textcolor=color.white, size=size.small)
        last_sweep_bar := bar_index
        is_bear_sweep := true

if show_amd
    in_acc = not na(time(timeframe.period, amd_session))
    var float acc_h = na, var float acc_l = na, var int acc_s = na
    if in_acc
        if not in_acc[1]
            acc_h := high, acc_l := low, acc_s := bar_index
        else
            acc_h := math.max(acc_h, high), acc_l := math.min(acc_l, low)
    
    if not in_acc and in_acc[1] 
        box.new(acc_s, acc_h, bar_index, acc_l, bgcolor=color.new(color.gray, 90), border_color=color.new(color.gray, 50), text="ACCUMULATION", text_size=size.tiny, text_color=color.gray)

// ==========================================
// 6. MTF DASHBOARD (Top Right)
// ==========================================

mtf_is_bull = close > htf_ema_val
bgcolor(show_mtf_bg ? (mtf_is_bull ? color.new(color_bull, 95) : color.new(color_bear, 95)) : na)

f_add_cell(table_id, row, tf_name, bias_val, col_bull, col_bear) =>
    c = bias_val == 1 ? color.new(col_bull, 20) : color.new(col_bear, 20)
    table.cell(table_id, 0, row, tf_name, bgcolor=color.rgb(10, 10, 10), text_color=color.gray, text_size=size.small)
    table.cell(table_id, 1, row, bias_val == 1 ? "BULL" : "BEAR", bgcolor=c, text_color=color.white, text_size=size.small)

if show_dashboard and barstate.islast
    d_pos = dash_pos == 'Top Right' ? position.top_right : dash_pos == 'Bottom Right' ? position.bottom_right : dash_pos == 'Top Left' ? position.top_left : position.bottom_left
    var table dash = table.new(d_pos, 2, 5, border_width=1, border_color=color.new(color.gray, 50))
    table.cell(dash, 0, 0, "Timeframe", bgcolor=color.rgb(20, 20, 20), text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 0, "Bias", bgcolor=color.rgb(20, 20, 20), text_color=color.white, text_size=size.small)
    
    f_add_cell(dash, 1, "15m", m15_bias, color_bull, color_bear)
    f_add_cell(dash, 2, "1h",  h1_bias, color_bull, color_bear)
    f_add_cell(dash, 3, "4h",  h4_bias, color_bull, color_bear)
    f_add_cell(dash, 4, "1D",  (close > htf_ema_val ? 1 : -1), color_bull, color_bear)

// ==========================================
// 7. ADVANCED DELTA VOLUME ENGINE
// ==========================================

float _range = high - low
float buy_v   = _range > 0 ? volume * (close - low) / _range : volume / 2
float sell_v  = _range > 0 ? volume * (high - close) / _range : volume / 2
float delta_v = buy_v - sell_v
float delta_cum = ta.cum(delta_v)

float v_avg_20 = ta.sma(volume, 20)
bool  v_surge  = volume > (v_avg_20 * 1.5)
bool  v_climax = volume > (v_avg_20 * 2.5)

float buy_pct  = volume > 0 ? (buy_v / volume) * 100 : 50.0
float sell_pct = volume > 0 ? (sell_v / volume) * 100 : 50.0

float delta_sma_5  = ta.sma(delta_v, 5)
float delta_sma_20 = ta.sma(delta_v, 20)
float obv_val = ta.cum(close > close[1] ? volume : close < close[1] ? -volume : 0)
float obv_sma = ta.sma(obv_val, 20)
float vwap_val = ta.vwap(close)
float vwap_dev = close - vwap_val
float vwap_pct = vwap_val != 0 ? (vwap_dev / vwap_val) * 100 : 0
float vol_roc = volume[10] != 0 ? ((volume - volume[10]) / volume[10]) * 100 : 0
float vw_rsi = ta.rsi(close * volume, 14)

float mfm     = _range > 0 ? ((close - low) - (high - close)) / _range : 0
float mfv     = mfm * volume
float cmf_val = v_avg_20 != 0 ? ta.sma(mfv, 20) / v_avg_20 : 0

float body_size    = math.abs(close - open)
float candle_range = high - low
bool  absorption   = candle_range > 0 and (body_size / candle_range < 0.3) and v_surge

var int delta_streak = 0
if delta_v > 0
    delta_streak := delta_streak >= 0 ? delta_streak + 1 : 1
else if delta_v < 0
    delta_streak := delta_streak <= 0 ? delta_streak - 1 : -1
else
    delta_streak := 0

float vol_ratio = v_avg_20 != 0 ? volume / v_avg_20 : 1.0
float net_delta_10 = math.sum(delta_v, 10)

// ==========================================
// 8. SPEEDOMETER SCORE (0-100 Composite)
// ==========================================

float rsi_val = ta.rsi(close, 14)
[macdLine, signalLine, histLine] = ta.macd(close, 12, 26, 9)

float p_score = 50.0
p_score := p_score + (delta_v > 0 ? 7 : -7)
p_score := p_score + (delta_sma_5 > 0 ? 5 : -5)
p_score := p_score + (obv_val > obv_sma ? 7 : -7)
p_score := p_score + (cmf_val > 0 ? 7 : -7)
p_score := p_score + (vwap_dev > 0 ? 5 : -5)
p_score := p_score + (vw_rsi > 50 ? 5 : -5)
p_score := p_score + (net_delta_10 > 0 ? 5 : -5)
p_score := p_score + (rsi_val > 50 ? 4 : -4)
p_score := p_score + (macdLine > signalLine ? 5 : -5)
p_score := math.max(0, math.min(100, p_score))

f_speedometer(val) =>
    string needle = ""
    if val >= 85
        needle := "▓▓▓▓▓▓▓▓▓▓ 🟢 EXTREME BUY"
    else if val >= 70
        needle := "▓▓▓▓▓▓▓▓░░ 🟢 STRONG BUY"
    else if val >= 55
        needle := "▓▓▓▓▓▓░░░░ 🟡 LEAN BUY"
    else if val >= 45
        needle := "▓▓▓▓▓░░░░░ ⚪ NEUTRAL"
    else if val >= 30
        needle := "░░░░▓▓▓▓░░ 🟡 LEAN SELL"
    else if val >= 15
        needle := "░░▓▓▓▓▓▓▓░ 🔴 STRONG SELL"
    else
        needle := "▓▓▓▓▓▓▓▓▓▓ 🔴 EXTREME SELL"
    needle

f_bar_meter(val, max_val) =>
    int bars_filled = math.round((math.min(math.abs(val), max_val) / max_val) * 10)
    string meter = ""
    for i = 0 to 9
        meter := meter + (i < bars_filled ? "█" : "░")
    meter

// ==========================================
// 9. ADVANCED DELTA VOLUME DASHBOARD (Bottom Center)
// ==========================================

color COLOR_BG = #080a12
color COLOR_TXT = #ffffff

var table v_dash = show_vol_dash ? table.new(position.bottom_center, 7, 8, bgcolor=color.new(COLOR_BG, 5), border_color=color.new(COLOR_TXT, 85), border_width=1, frame_color=color.new(COLOR_TXT, 70), frame_width=2) : na

if barstate.islast and show_vol_dash
    color hdr_bg = color.new(COLOR_TXT, 90)
    table.cell(v_dash, 0, 0, "⚡ DELTA VOL",    text_color=vol_bull_col, text_size=size.small, bgcolor=hdr_bg)
    table.cell(v_dash, 1, 0, "📊 BUY / SELL",   text_color=COLOR_TXT, text_size=size.small, bgcolor=hdr_bg)
    table.cell(v_dash, 2, 0, "🔥 SURGE",        text_color=COLOR_TXT, text_size=size.small, bgcolor=hdr_bg)
    table.cell(v_dash, 3, 0, "💧 FLOW",          text_color=COLOR_TXT, text_size=size.small, bgcolor=hdr_bg)
    table.cell(v_dash, 4, 0, "📈 OBV TREND",    text_color=COLOR_TXT, text_size=size.small, bgcolor=hdr_bg)
    table.cell(v_dash, 5, 0, "🎯 MOMENTUM",     text_color=COLOR_TXT, text_size=size.small, bgcolor=hdr_bg)
    table.cell(v_dash, 6, 0, "⏱ TREND",         text_color=COLOR_TXT, text_size=size.small, bgcolor=hdr_bg)

    color delta_col = delta_v >= 0 ? vol_bull_col : vol_bear_col
    table.cell(v_dash, 0, 1, str.tostring(delta_v, "#,###"), text_color=delta_col, text_size=size.normal)
    table.cell(v_dash, 1, 1, str.tostring(buy_pct, "0.0") + "% ▲\n" + str.tostring(sell_pct, "0.0") + "% ▼", text_color=COLOR_TXT, text_size=size.small)
    string surge_txt = v_climax ? "🔴 CLIMAX" : v_surge ? "🟡 HIGH" : "⚪ NORMAL"
    color  surge_col = v_climax ? #ff4444 : v_surge ? #ffd700 : COLOR_TXT
    table.cell(v_dash, 2, 1, surge_txt, text_color=surge_col, text_size=size.normal)
    table.cell(v_dash, 3, 1, delta_v > 0 ? "ACCUM ▲" : "DISTR ▼", text_color=delta_col, text_size=size.normal)
    color obv_col = obv_val > obv_sma ? vol_bull_col : vol_bear_col
    table.cell(v_dash, 4, 1, obv_val > obv_sma ? "BULLISH ▲" : "BEARISH ▼", text_color=obv_col, text_size=size.normal)
    color macd_col = macdLine > signalLine ? vol_bull_col : vol_bear_col
    table.cell(v_dash, 5, 1, macdLine > signalLine ? "BULL MOM" : "BEAR MOM", text_color=macd_col, text_size=size.normal)
    color trend_col = trend_state == 1 ? vol_bull_col : trend_state == -1 ? vol_bear_col : COLOR_TXT
    table.cell(v_dash, 6, 1, trend_state == 1 ? "BULLISH" : trend_state == -1 ? "BEARISH" : "NEUTRAL", text_color=trend_col, text_size=size.normal)

    color row2_bg = color.new(COLOR_BG, 0)
    table.cell(v_dash, 0, 2, "CUM Δ: " + str.tostring(delta_cum, "#,###"), text_color=delta_cum >= 0 ? vol_bull_col : vol_bear_col, text_size=size.tiny, bgcolor=row2_bg)
    table.cell(v_dash, 1, 2, "VOL: " + str.tostring(volume, "#,###"), text_color=color.new(COLOR_TXT, 30), text_size=size.tiny, bgcolor=row2_bg)
    table.cell(v_dash, 2, 2, "RATIO: " + str.tostring(vol_ratio, "0.0") + "x", text_color=vol_ratio > 1.5 ? #ffd700 : color.new(COLOR_TXT, 30), text_size=size.tiny, bgcolor=row2_bg)
    table.cell(v_dash, 3, 2, "NET Δ10: " + str.tostring(net_delta_10, "#,###"), text_color=net_delta_10 >= 0 ? vol_bull_col : vol_bear_col, text_size=size.tiny, bgcolor=row2_bg)
    table.cell(v_dash, 4, 2, "OBV: " + str.tostring(obv_val, "#,###"), text_color=color.new(COLOR_TXT, 30), text_size=size.tiny, bgcolor=row2_bg)
    table.cell(v_dash, 5, 2, "RSI: " + str.tostring(rsi_val, "0.0"), text_color=rsi_val > 70 ? vol_bear_col : rsi_val < 30 ? vol_bull_col : COLOR_TXT, text_size=size.tiny, bgcolor=row2_bg)
    table.cell(v_dash, 6, 2, "MACD: " + str.tostring(histLine, "0.00"), text_color=histLine > 0 ? vol_bull_col : vol_bear_col, text_size=size.tiny, bgcolor=row2_bg)

    color vwap_col = vwap_dev >= 0 ? vol_bull_col : vol_bear_col
    table.cell(v_dash, 0, 3, "VWAP DEV", text_color=color.new(COLOR_TXT, 50), text_size=size.tiny)
    table.cell(v_dash, 1, 3, str.tostring(vwap_dev, "#.##") + " (" + str.tostring(vwap_pct, "0.00") + "%)", text_color=vwap_col, text_size=size.tiny)
    color cmf_col = cmf_val >= 0 ? vol_bull_col : vol_bear_col
    table.cell(v_dash, 2, 3, "CMF", text_color=color.new(COLOR_TXT, 50), text_size=size.tiny)
    table.cell(v_dash, 3, 3, str.tostring(cmf_val, "0.000"), text_color=cmf_col, text_size=size.tiny)
    table.cell(v_dash, 4, 3, "VW-RSI", text_color=color.new(COLOR_TXT, 50), text_size=size.tiny)
    color rsi_col = vw_rsi > 70 ? vol_bull_col : vw_rsi < 30 ? vol_bear_col : COLOR_TXT
    table.cell(v_dash, 5, 3, str.tostring(vw_rsi, "0.0"), text_color=rsi_col, text_size=size.tiny)
    table.cell(v_dash, 6, 3, "VWAP: " + str.tostring(vwap_val, format.mintick), text_color=color.new(COLOR_TXT, 30), text_size=size.tiny)

    table.cell(v_dash, 0, 4, "VOL MOMO", text_color=color.new(COLOR_TXT, 50), text_size=size.tiny)
    color momo_col = vol_roc > 50 ? vol_bull_col : vol_roc < -50 ? vol_bear_col : COLOR_TXT
    table.cell(v_dash, 1, 4, str.tostring(vol_roc, "0.0") + "%", text_color=momo_col, text_size=size.tiny)
    table.cell(v_dash, 2, 4, "Δ STREAK", text_color=color.new(COLOR_TXT, 50), text_size=size.tiny)
    color streak_col = delta_streak > 0 ? vol_bull_col : delta_streak < 0 ? vol_bear_col : COLOR_TXT
    table.cell(v_dash, 3, 4, str.tostring(delta_streak), text_color=streak_col, text_size=size.tiny)
    table.cell(v_dash, 4, 4, "ABSORB", text_color=color.new(COLOR_TXT, 50), text_size=size.tiny)
    table.cell(v_dash, 5, 4, absorption ? "⚠ DETECTED" : "—", text_color=absorption ? #ffd700 : color.new(COLOR_TXT, 50), text_size=size.tiny)
    table.cell(v_dash, 6, 4, "AVG20: " + str.tostring(v_avg_20, "#,###"), text_color=color.new(COLOR_TXT, 30), text_size=size.tiny)

    table.cell(v_dash, 0, 5, "Δ SMA5", text_color=color.new(COLOR_TXT, 50), text_size=size.tiny)
    table.cell(v_dash, 1, 5, str.tostring(delta_sma_5, "#,###"), text_color=delta_sma_5 >= 0 ? vol_bull_col : vol_bear_col, text_size=size.tiny)
    table.cell(v_dash, 2, 5, "Δ SMA20", text_color=color.new(COLOR_TXT, 50), text_size=size.tiny)
    table.cell(v_dash, 3, 5, str.tostring(delta_sma_20, "#,###"), text_color=delta_sma_20 >= 0 ? vol_bull_col : vol_bear_col, text_size=size.tiny)
    table.cell(v_dash, 4, 5, "PRICE", text_color=color.new(COLOR_TXT, 50), text_size=size.tiny)
    table.cell(v_dash, 5, 5, str.tostring(close, format.mintick), text_color=COLOR_TXT, text_size=size.tiny)
    string struct_txt = trend_state == 1 ? "BOS ▲ BULL" : trend_state == -1 ? "BOS ▼ BEAR" : "—"
    table.cell(v_dash, 6, 5, struct_txt, text_color=trend_col, text_size=size.tiny)

    string buy_meter  = "BUY  " + f_bar_meter(buy_pct, 100)
    string sell_meter = "SELL " + f_bar_meter(sell_pct, 100)
    table.cell(v_dash, 0, 6, buy_meter, text_color=vol_bull_col, text_size=size.tiny, text_halign=text.align_left)
    table.cell(v_dash, 1, 6, "", text_size=size.tiny)
    table.cell(v_dash, 2, 6, sell_meter, text_color=vol_bear_col, text_size=size.tiny, text_halign=text.align_left)
    table.cell(v_dash, 3, 6, "", text_size=size.tiny)
    string strength_txt = buy_pct > 70 ? "🟢 DOMINANT BUYERS" : sell_pct > 70 ? "🔴 DOMINANT SELLERS" : buy_pct > 55 ? "🟢 BUYERS EDGE" : sell_pct > 55 ? "🔴 SELLERS EDGE" : "⚪ BALANCED"
    color  strength_col = buy_pct > 55 ? vol_bull_col : sell_pct > 55 ? vol_bear_col : COLOR_TXT
    table.cell(v_dash, 4, 6, strength_txt, text_color=strength_col, text_size=size.tiny)
    table.cell(v_dash, 5, 6, "", text_size=size.tiny)
    table.cell(v_dash, 6, 6, "", text_size=size.tiny)

    color spd_bg = color.new(COLOR_TXT, 92)
    color p_col = p_score >= 65 ? vol_bull_col : p_score <= 35 ? vol_bear_col : #ffd700
    string p_label = p_score >= 75 ? "STRONG BUY" : p_score >= 55 ? "LEAN BULL" : p_score <= 25 ? "STRONG SELL" : p_score <= 45 ? "LEAN BEAR" : "NEUTRAL"

    table.cell(v_dash, 0, 7, "🏎 SPEEDOMETER", text_color=#ffd700, text_size=size.small, bgcolor=spd_bg)
    table.cell(v_dash, 1, 7, str.tostring(p_score, "0") + " / 100", text_color=p_col, text_size=size.normal, bgcolor=spd_bg)
    table.cell(v_dash, 2, 7, p_label, text_color=p_col, text_size=size.small, bgcolor=spd_bg)
    table.cell(v_dash, 3, 7, f_speedometer(p_score), text_color=p_col, text_size=size.tiny, bgcolor=spd_bg, text_halign=text.align_left)
    table.cell(v_dash, 4, 7, "", text_size=size.tiny, bgcolor=spd_bg)
    table.cell(v_dash, 5, 7, "", text_size=size.tiny, bgcolor=spd_bg)
    table.cell(v_dash, 6, 7, "IET ULTRA | SMART MONEY", text_color=color.new(COLOR_TXT, 60), text_size=size.tiny, bgcolor=spd_bg)

// ==========================================
// 10. REAL INSTITUTIONAL CONFLUENCE ENGINE (THE FIX!)
// ==========================================

// 1. Structure & Trend Alignment
bool bull_structure = (trend_state == 1) or (ta.change(trend_state) > 0)
bool bear_structure = (trend_state == -1) or (ta.change(trend_state) < 0)

// 2. Higher Timeframe Daily Trend Alignment
bool htf_bull_ok = require_htf_ema ? (close > htf_ema_val) : true
bool htf_bear_ok = require_htf_ema ? (close < htf_ema_val) : true

// 3. Mathematical Speedometer Momentum Alignment
bool speed_bull_ok = (p_score >= min_speedometer)
bool speed_bear_ok = (p_score <= (100 - min_speedometer))

// 4. Delta Volume Institutional Order Flow
bool delta_bull_ok = require_delta ? (delta_v > 0 and delta_sma_5 > 0) : true
bool delta_bear_ok = require_delta ? (delta_v < 0 and delta_sma_5 < 0) : true

// 5. Smart Money Concept Catalyst (FVG mitigation, Sweep, or confirmed BOS)
bool smc_bull_catalyst = is_fvg_bull or is_bull_sweep or (ta.change(trend_state) > 0)
bool smc_bear_catalyst = is_fvg_bear or is_bear_sweep or (ta.change(trend_state) < 0)

// ★ THE MASTER QUANT ENTRY TRIGGER
bool is_master_buy  = bull_structure and htf_bull_ok and speed_bull_ok and delta_bull_ok and smc_bull_catalyst and barstate.isconfirmed
bool is_master_sell = bear_structure and htf_bear_ok and speed_bear_ok and delta_bear_ok and smc_bear_catalyst and barstate.isconfirmed

// Cooldown to prevent duplicate entries on successive bars
var int last_trade_bar = 0
bool can_enter = (bar_index - last_trade_bar) >= 5

bool exec_buy  = is_master_buy and can_enter
bool exec_sell = is_master_sell and can_enter

if exec_buy or exec_sell
    last_trade_bar := bar_index

// ==========================================
// 11. DYNAMIC STRUCTURAL SL & 1:2.5+ TP LEVELS
// ==========================================

// Precision format according to asset price
int price_digits = close > 1000 ? 2 : close > 100 ? 3 : 5

var float live_sl = na
var float live_tp = na
var float live_entry = na
var string live_side = ""

if exec_buy
    float struct_low = not na(last_sl_val) ? math.min(low, last_sl_val) : low
    live_sl := struct_low - (atr_sys * 0.8)
    float risk = close - live_sl
    live_tp := close + (risk * min_rr_ratio)
    live_entry := close
    live_side := "BUY"

if exec_sell
    float struct_high = not na(last_sh_val) ? math.max(high, last_sh_val) : high
    live_sl := struct_high + (atr_sys * 0.8)
    float risk = live_sl - close
    live_tp := close - (risk * min_rr_ratio)
    live_entry := close
    live_side := "SELL"

// Plot Master Signal Badges
plotshape(exec_buy,  "Institutional Quant Buy",  shape.labelup,   location.belowbar, color.new(#00f0ff, 0), text="INSTITUTIONAL\nBUY 1:2.5", textcolor=color.black, size=size.small)
plotshape(exec_sell, "Institutional Quant Sell", shape.labeldown, location.abovebar, color.new(#ff0070, 0), text="INSTITUTIONAL\nSELL 1:2.5", textcolor=color.white, size=size.small)

// Plot dynamic target levels during active trade
plot(exec_buy or exec_sell ? live_tp : na, "Target TP", color=color.new(#00ffbb, 0), style=plot.style_circles, linewidth=2)
plot(exec_buy or exec_sell ? live_sl : na, "Protect SL", color=color.new(#ff0055, 0), style=plot.style_circles, linewidth=2)

// ==========================================
// 12. AUTOMATED CLEVER TRADER JSON WEBHOOK ALERTS
// ==========================================

if exec_buy and enable_ct_alert
    string buy_json = '{"secret":"' + secret_key + '","symbol":"' + syminfo.ticker + '","action":"BUY","price":' + str.tostring(live_entry, format.mintick) + ',"sl":' + str.tostring(live_sl, format.mintick) + ',"tp":' + str.tostring(live_tp, format.mintick) + ',"strategy":"IET Ultra SMC Confluence","speedometer":' + str.tostring(p_score, "0") + '}'
    alert(buy_json, alert.freq_once_per_bar_close)

if exec_sell and enable_ct_alert
    string sell_json = '{"secret":"' + secret_key + '","symbol":"' + syminfo.ticker + '","action":"SELL","price":' + str.tostring(live_entry, format.mintick) + ',"sl":' + str.tostring(live_sl, format.mintick) + ',"tp":' + str.tostring(live_tp, format.mintick) + ',"strategy":"IET Ultra SMC Confluence","speedometer":' + str.tostring(p_score, "0") + '}'
    alert(sell_json, alert.freq_once_per_bar_close)

alertcondition(exec_buy,  "IET Ultra Pro BUY Alert",  "Institutional Confluence BUY Triggered!")
alertcondition(exec_sell, "IET Ultra Pro SELL Alert", "Institutional Confluence SELL Triggered!")
