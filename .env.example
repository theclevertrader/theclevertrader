# THE CLEVER TRADER — Environment Configuration

# Server
PORT=3000
NODE_ENV=development

# Application Mode: DEMO | PAPER | LIVE
APP_MODE=PAPER

# AI Providers (Optional - Built-in institutional offline reasoning engine active by default)
# Add keys below or configure them dynamically in the Terminal Settings UI
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_AI_PROVIDER=offline

# Market Data Feed (Optional - Realistic real-time synthetic institutional feed active by default)
MARKET_DATA_API_KEY=
FINNHUB_API_KEY=
POLYGON_API_KEY=
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=
BLS_API_KEY=
BEA_API_KEY=
TRADING_ECONOMICS_API_KEY=
XOOMAR_API_KEY=
FMP_API_KEY=
FINANCIAL_MODELING_PREP_API_KEY=
MARKETSTACK_API_KEY=
MASSIVE_API_KEY=
OPENFIGI_API_KEY=
NASDAQ_DATA_LINK_API_KEY=

# Broker Adapter (Optional - Safe Paper Broker active by default)
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_ENDPOINT=

# Webhook Notifications (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Default Risk Parameters
DEFAULT_ACCOUNT_BALANCE=50000
DEFAULT_RISK_PERCENT=1.0
DEFAULT_MAX_DAILY_LOSS=3.0
DEFAULT_MICRO_SCALP_LOT=0.01
DEFAULT_MICRO_SCALP_RISK=3.00
DEFAULT_MICRO_SCALP_REWARD=9.00
