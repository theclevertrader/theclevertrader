// ═══════════════════════════════════════════════════════════════
// SESSION EMA + RSI SCALPER — GOLD HIGH WIN RATE
// The Clever Trader | Consistent Scalping Model
// ═══════════════════════════════════════════════════════════════
// HOW IT WORKS:
// 1. 200 EMA = Overall trend direction
// 2. 9 EMA crosses 21 EMA = Momentum signal
// 3. RSI > 50 for buys, RSI < 50 for sells
// 4. London-NY Overlap sirf (8AM-11AM EST)
// 5. ATR-based SL with 1:1.5 R:R target
// ═══════════════════════════════════════════════════════════════

//@version=5
strategy("Session EMA+RSI Scalper — Gold [Clever Trader]", overlay=true,
  default_qty_type=strategy.percent_of_equity, default_qty_value=0.5,
  calc_on_every_tick=false, commission_value=0.015, slippage=2)

// === INPUTS ===
emaLong    = input.int(200, "Trend EMA")
emaFast    = input.int(9, "Fast EMA")
emaSlow    = input.int(21, "Slow EMA")
rsiLen     = input.int(14, "RSI Length")
rsiThresh  = input.int(50, "RSI Threshold")
atrLen     = input.int(14, "ATR Length")
slMult     = input.float(1.5, "SL ATR Multiplier")
rrRatio    = input.float(1.5, "Reward:Risk Ratio")
session    = input.session("0800-1100", "London-NY Overlap (EST)")
useSession = input.bool(true, "Enable Session Filter")

// === CALCULATIONS ===
ema200 = ta.ema(close, emaLong)
ema9   = ta.ema(close, emaFast)
ema21  = ta.ema(close, emaSlow)
rsi    = ta.rsi(close, rsiLen)
atr    = ta.atr(atrLen)
inSession = useSession ? time(timeframe.period, session, "America/New_York") : true

// === TREND DIRECTION ===
bullTrend = close > ema200
bearTrend = close < ema200

// === ENTRY SIGNALS ===
longSignal  = bullTrend and ta.crossover(ema9, ema21) and rsi > rsiThresh and inSession and barstate.isconfirmed
shortSignal = bearTrend and ta.crossunder(ema9, ema21) and rsi < rsiThresh and inSession and barstate.isconfirmed

// === SL/TP CALCULATION ===
slDist = atr * slMult
tpDist = slDist * rrRatio

// === EXECUTE ===
if longSignal and strategy.position_size <= 0
    strategy.entry("Long", strategy.long)
    strategy.exit("TP/SL Long", "Long", 
      stop=close - slDist, limit=close + tpDist)

if shortSignal and strategy.position_size >= 0
    strategy.entry("Short", strategy.short)
    strategy.exit("TP/SL Short", "Short", 
      stop=close + slDist, limit=close - tpDist)

// === VISUALS ===
// EMAs
plot(ema200, "200 EMA", color.new(color.gray, 20), 3)
plot(ema9, "9 EMA", color.new(#06b6d4, 0), 1)
plot(ema21, "21 EMA", color.new(#f59e0b, 0), 1)

// EMA Fill (momentum zone)
p1 = plot(ema9, display=display.none)
p2 = plot(ema21, display=display.none)
fill(p1, p2, ema9 > ema21 ? color.new(#10b981, 85) : color.new(#f43f5e, 85), title="EMA Zone")

// Session highlight
bgcolor(inSession and useSession ? color.new(#8b5cf6, 95) : na, title="Active Session")

// Signals
plotshape(longSignal, "Buy Signal", shape.triangleup, location.belowbar, 
  color.new(#10b981, 0), size=size.small, text="BUY")
plotshape(shortSignal, "Sell Signal", shape.triangledown, location.abovebar, 
  color.new(#f43f5e, 0), size=size.small, text="SELL")

// RSI in separate pane
// (uncomment if you want RSI panel)
