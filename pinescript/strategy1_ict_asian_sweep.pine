// ═══════════════════════════════════════════════════════════════
// ICT ASIAN RANGE LIQUIDITY SWEEP — XAUUSD STRATEGY
// The Clever Trader | Institutional SMC Setup
// ═══════════════════════════════════════════════════════════════
// HOW IT WORKS:
// 1. Asian Session (7PM-12AM NY) ka High aur Low mark karta hai
// 2. London Killzone (2AM-5AM) ya NY Killzone (7AM-10AM) mein
//    jab price Asian High/Low ko sweep kare = SIGNAL
// 3. Sweep ke baad reversal = HIGH PROBABILITY trade
// ═══════════════════════════════════════════════════════════════

//@version=5
indicator("ICT Asian Range Sweep — XAUUSD [Clever Trader]", overlay=true, max_labels_count=500)

// === INPUTS ===
asianStart  = input.session("1900-0000", "Asian Session (NY Time)")
londonKZ    = input.session("0200-0500", "London Killzone")
nyKZ        = input.session("0700-1000", "New York Killzone")
showRange   = input.bool(true, "Show Asian Range Lines")
showLabels  = input.bool(true, "Show SL/TP Labels")
atrLen      = input.int(14, "ATR Length for SL/TP")
slMult      = input.float(1.5, "SL ATR Multiplier")
tpMult      = input.float(3.0, "TP ATR Multiplier")

// === ASIAN RANGE HIGH/LOW ===
inAsian     = time(timeframe.period, asianStart, "America/New_York")
var float asianHigh = na
var float asianLow  = na
var bool newDay     = false

// Reset range on new day
if ta.change(time("D")) != 0
    asianHigh := na
    asianLow  := na
    newDay    := true

if inAsian
    if na(asianHigh)
        asianHigh := high
        asianLow  := low
    else
        asianHigh := math.max(asianHigh, high)
        asianLow  := math.min(asianLow, low)

// === PLOT ASIAN RANGE ===
ahPlot = plot(showRange and not na(asianHigh) ? asianHigh : na, "Asian High", 
  color.new(#f43f5e, 30), 2, plot.style_stepline)
alPlot = plot(showRange and not na(asianLow) ? asianLow : na, "Asian Low", 
  color.new(#10b981, 30), 2, plot.style_stepline)
fill(ahPlot, alPlot, color.new(color.purple, 92), title="Asian Range Fill")

// === KILLZONE DETECTION ===
inLondon   = time(timeframe.period, londonKZ, "America/New_York")
inNY       = time(timeframe.period, nyKZ, "America/New_York")
inKillzone = (inLondon or inNY) and not na(asianHigh) and not na(asianLow)

// Highlight killzone background
bgcolor(inLondon ? color.new(#3b82f6, 94) : na, title="London KZ")
bgcolor(inNY ? color.new(#f59e0b, 94) : na, title="NY KZ")

// === SWEEP DETECTION ===
// Bearish Sweep: Price goes ABOVE Asian High then closes BELOW it (liquidity grab)
sweepHigh = inKillzone and high > asianHigh and close < asianHigh

// Bullish Sweep: Price goes BELOW Asian Low then closes ABOVE it (liquidity grab)
sweepLow  = inKillzone and low < asianLow and close > asianLow

// === SIGNAL ARROWS ===
plotshape(sweepHigh, "Bearish Sweep", shape.triangledown, location.abovebar, 
  color.new(#f43f5e, 0), size=size.normal, text="SELL\nSWEEP")
plotshape(sweepLow, "Bullish Sweep", shape.triangleup, location.belowbar, 
  color.new(#10b981, 0), size=size.normal, text="BUY\nSWEEP")

// === ATR BASED SL/TP LABELS ===
atr = ta.atr(atrLen)

if sweepLow and showLabels
    slPrice = low - atr * slMult
    tpPrice = close + atr * tpMult
    label.new(bar_index, low, 
      "BUY SETUP\n----------\nEntry: " + str.tostring(close, "#.##") + 
      "\nSL: " + str.tostring(slPrice, "#.##") + 
      "\nTP: " + str.tostring(tpPrice, "#.##") + 
      "\nR:R = 1:" + str.tostring(tpMult / slMult, "#.#"),
      style=label.style_label_up, color=color.new(#10b981, 20), 
      textcolor=color.white, size=size.normal)

if sweepHigh and showLabels
    slPrice = high + atr * slMult
    tpPrice = close - atr * tpMult
    label.new(bar_index, high, 
      "SELL SETUP\n----------\nEntry: " + str.tostring(close, "#.##") + 
      "\nSL: " + str.tostring(slPrice, "#.##") + 
      "\nTP: " + str.tostring(tpPrice, "#.##") + 
      "\nR:R = 1:" + str.tostring(tpMult / slMult, "#.#"),
      style=label.style_label_down, color=color.new(#f43f5e, 20), 
      textcolor=color.white, size=size.normal)

// === ALERTS ===
alertcondition(sweepHigh, "Bearish Asian High Sweep!", 
  "XAUUSD: Price swept Asian HIGH in killzone — SELL setup!")
alertcondition(sweepLow, "Bullish Asian Low Sweep!", 
  "XAUUSD: Price swept Asian LOW in killzone — BUY setup!")
alertcondition(sweepHigh or sweepLow, "Any Asian Sweep!", 
  "XAUUSD: Asian Range Liquidity Sweep detected in killzone!")
